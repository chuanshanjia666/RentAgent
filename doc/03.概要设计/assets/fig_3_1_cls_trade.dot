digraph cls_trade {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="交易与合同模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>AppointmentController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- appointmentService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(AppointmentCreateReq): R&lt;ViewingAppointment&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ act(long, AppointmentActionReq): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ mine(page, size): R&lt;PageVO&lt;Map&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ received(page, size): R&lt;PageVO&lt;Map&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>ContractController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- contractService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(ContractCreateReq): R&lt;Contract&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ act(long, ContractActionReq): R&lt;Map&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detail(long): R&lt;Contract&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ mine(page, size): R&lt;PageVO&lt;Contract&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ interpret(long): R&lt;InterpVO&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ orders(page, size): R&lt;PageVO&lt;Map&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ bills(long): R&lt;List&lt;RentBill&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ payBill(long): R&lt;Void&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>AppointmentService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service（状态机）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ST_PENDING=0 / ST_CONFIRMED=1 / ST_REJECTED=2 / ST_COMPLETED=3 / ST_CANCELLED=4</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- appointmentMapper / houseMapper / notificationService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(long, LocalDateTime, String, long): ViewingAppointment</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ act(long, String, String, long, int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pageFor(long, boolean, long, long): Page&lt;Map&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toVO(ViewingAppointment): Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 唯一索引(house_id, appointment_time) 防时段冲突</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>ContractService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service（状态机）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ST_TENANT_CONFIRM=0 / ST_LANDLORD_CONFIRM=1 / ST_EFFECTIVE=2</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ST_TERMINATED=3 / ST_VOIDED=4</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- contractMapper / orderMapper / billMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(long, LocalDate, LocalDate, long): Contract</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ act(long, String, long, int): Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detail(long): Contract</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ mine(long, long, long): Page&lt;Contract&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ orders(long, int, long, long): Page&lt;Map&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ bills(long, long): List&lt;RentBill&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ payBill(long, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- renderTemplate(): clauses JSON 模板填充</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- generateBills(LeaseOrder): 按月生成账单（幂等）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 合同生效 → 房源状态置为已出租</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>ViewingAppointmentMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;ViewingAppointment&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>ContractMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;Contract&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>LeaseOrderMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;LeaseOrder&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>RentBillMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;RentBill&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>Contract / LeaseOrder / RentBill</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">Contract：house/tenant/landlord, clauses, risk_flags, 起止日期, status, 双方签署时间</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">LeaseOrder：contract_id(唯一), house/tenant/landlord, 租期, 月租, 押金, status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">RentBill：lease_order_id, period_no, due_date, amount, status, paid_at</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 contract / lease_order / rent_bill）</TD></TR></TABLE></TD></TR></TABLE>>];
  x9 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>AnalysisService</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  x10 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>NotificationService</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  x11 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>HouseMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n2;
  n1 -> n3;
  n1 -> x9 [label="FR-14 解读"];
  n2 -> n4;
  n2 -> x10 [label="预约通知"];
  n3 -> n5;
  n3 -> n6 [label="派生订单"];
  n3 -> n7 [label="账单计划"];
  n3 -> x10 [label="签约通知"];
  n3 -> x11 [label="置为已出租"];
  n4 -> n8 [label="同一实体包"];
  n5 -> n8 [label="同一实体包"];
}
