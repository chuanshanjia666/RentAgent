digraph cls_auth {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="用户与权限模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>AuthController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- authService: AuthService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sendCaptcha(CaptchaReq): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(RegisterReq): R&lt;TokenResp&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login(LoginReq): R&lt;TokenResp&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ currentUser(): R&lt;Map&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ updateProfile(UpdateProfileReq): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ changePassword(ChangePasswordReq): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ submitRealname(RealnameReq): R&lt;Void&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>AuthService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userMapper: SysUserMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- realnameMapper: RealnameAuthMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- redis: StringRedisTemplate</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sendCaptcha(String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(RegisterReq): TokenResp</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login(LoginReq): TokenResp</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ submitRealname(long, RealnameReq): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ realnameOf(long): RealnameVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ realnamePassed(long): boolean</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7e7e7"><B>JwtUtil</B></TD></TR><TR><TD BGCOLOR="#f7e7e7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;security&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- secret: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- expireHours: long</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ issue(long, int): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ verify(String): Claims</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7e7e7"><B>JwtAuthFilter</B></TD></TR><TR><TD BGCOLOR="#f7e7e7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;security&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jwtUtil: JwtUtil</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userMapper: SysUserMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ doFilterInternal(req, resp, chain): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 校验令牌有效性 / 用户禁用即时生效</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7e7e7"><B>RoleInterceptor</B></TD></TR><TR><TD BGCOLOR="#f7e7e7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;security&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- handler: HandlerMethod</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ preHandle(req, resp, handler): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 解析 @RequireRole 所需角色集合</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef4fb"><B>UserContext</B></TD></TR><TR><TD BGCOLOR="#eef4fb"><FONT POINT-SIZE="9" COLOR="#666666">&#171;ThreadLocal 上下文&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ uid: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ role: Integer</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ set(long, int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ uid(): long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ role(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ clear(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>CryptoUtil</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;工具&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- aesKey: byte[]</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aesEncrypt(String): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aesDecrypt(String): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sha256(String): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ bcrypt(String): String</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>SysUser</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- username: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- password: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- phone: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- role: Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status: Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- deleted: Integer</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（MyBatis-Plus 映射 sys_user）</TD></TR></TABLE></TD></TR></TABLE>>];
  n8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>RealnameAuth</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userId: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- realName: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idCardNoEnc: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idCardHash: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status: Integer</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（MyBatis-Plus 映射 realname_auth）</TD></TR></TABLE></TD></TR></TABLE>>];
  x9 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>SysUserMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  x10 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>RealnameAuthMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n1 [label="调用"];
  n1 -> x9;
  n1 -> x10;
  n1 -> n6 [label="加密/哈希"];
  n3 -> n2;
  n3 -> n5 [label="写入上下文"];
  n4 -> n5 [label="读取角色"];
  n0 -> n2 [label="签发令牌"];
  n3 -> x9 [label="状态校验"];
  x9 -> n7 [label="映射"];
  x10 -> n8 [label="映射"];
}
