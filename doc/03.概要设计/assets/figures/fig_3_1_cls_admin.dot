digraph cls_admin {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="后台管理模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>AdminController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller（@RequireRole(3)）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- adminService / adminChatService / reportService / analysisService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ users(String, page, size): R&lt;PageVO&lt;SysUser&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setUserStatus(long, boolean): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pending(page, size): R&lt;PageVO&lt;House&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ audit(long, Map): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fakeDetect(long): R&lt;DetectVO&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ reports(int, page, size): R&lt;PageVO&lt;Map&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ handleReport(long, Map): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ audits(page, size): R&lt;PageVO&lt;AuditLog&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ chats(String, Integer, Boolean, Long, page, size)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ chatDetail(long id): R&lt;DetailVO&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dashboard(String): R&lt;Map&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>AdminService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userMapper / houseMapper / auditLogMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ users(String, long, long): Page&lt;SysUser&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setUserStatus(long, boolean, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pendingHouses(long, long): Page&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dashboard(String): Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ auditLogs(long, long): Page&lt;AuditLog&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 聚合统计：按日/周/月分组（FR-24）</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>AdminChatService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service（对话审计）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- sessionMapper / messageMapper / userMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sessions(String, Integer, Boolean, Long, long, long)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detail(long sessionId): DetailVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dashboardMetrics(String periodFormat): Map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- GROUP BY session_id 批量聚合，避免 N+1（NFR-05）</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>ReportService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reportMapper / reviewMapper / houseMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ page(int, long, long): Page&lt;Report&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ handle(long, String, long): void</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>AuditLogService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service（横切）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- auditLogMapper: AuditLogMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ log(long, String, String, Long, Map, String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 审核/禁用/处理举报等管理动作全量留痕</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>SysUserMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;SysUser&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>HouseMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ countGroupByDay/Week/Month()</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>ReportMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;Report&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>AuditLogMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;AuditLog&gt;&#187;</TD></TR></TABLE></TD></TR></TABLE>>];
  n9 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>SysUser / House / Report / AuditLog</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">SysUser：status 禁用即时生效（每请求状态校验）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">House：status 审核状态机 + reject_reason</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Report：多态关联 target_type/target_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AuditLog：operator_id, action, target_type, target_id, detail(JSON), ip</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 sys_user / house / report / audit_log）</TD></TR></TABLE></TD></TR></TABLE>>];
  x10 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>ReviewMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n1;
  n0 -> n2 [label="NFR-05 审计"];
  n0 -> n3;
  n0 -> n4 [label="留痕"];
  n2 -> n5 [label="人物信息"];
  n1 -> n2 [label="FR-24 AI 对话量"];
  n1 -> n5;
  n1 -> n6;
  n1 -> n8;
  n3 -> n7;
  n3 -> x10 [label="隐藏评价"];
  n3 -> n6 [label="房源整改"];
  n5 -> n9 [label="同一实体包"];
  n6 -> n9 [label="同一实体包"];
}
