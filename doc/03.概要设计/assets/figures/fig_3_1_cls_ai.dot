digraph cls_ai {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="AI 智能体服务模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>AiController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- chatService / kbService / analysisService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createSession(SessionCreateReq): R&lt;AiChatSession&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sessions(page, size): R&lt;PageVO&lt;AiChatSession&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ history(long id): R&lt;List&lt;MessageVO&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ send(long id, MessageSendReq): SseEmitter</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ engine(): R&lt;Map&lt;String,String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pricing(long id): R&lt;PricingVO&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ assistFill(Map req): R&lt;Map&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>ChatService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- sessionMapper / messageMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- agentEngine: AgentEngine</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ engineName(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ createSession(long, int, String): AiChatSession</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sessions(long, long, long): Page&lt;AiChatSession&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ history(long, long): List&lt;MessageVO&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ send(long, String, long): SseEmitter</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 组装角色设定 + 记忆窗口 + 工具表</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 异步回调中落库消息与工具调用</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>KbService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- docMapper / chunkMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ importDoc(String, int, String, String): KbDocument</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ search(String, int): List&lt;Map&lt;String,String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hit(String): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 中文关键词提取（停用词 + 二字滑窗）</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>AnalysisService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- analysisMapper / houseMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- llmGateway: LlmGateway</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pricing(House, long): PricingVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fakeDetect(long, long): DetectVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ interpret(long, long): InterpVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ assistFill(AiFillReq, long): AiFillVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 结果与输入快照写入 ai_analysis</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3e2f7"><B>AgentEngine</B></TD></TR><TR><TD BGCOLOR="#f3e2f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;接口（可插拔）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（唯一实现：LlmAgent）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ available(): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ describe(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ stream(long sessionId, long userId, int scene,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">         String userMessage, Callback callback): void</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3e2f7"><B>LlmAgent</B></TD></TR><TR><TD BGCOLOR="#f3e2f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;AgentEngine 实现&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- gateway: LlmGateway</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- toolProvider: HousingToolProvider</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- memory(Redis 窗口 + 摘要)</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ stream(...): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- LangChain4j AiServices 编排（ReAct）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 按 scene 路由角色设定与工具集</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 流式丢失 tool_calls 时改非流式重跑一次</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3e2f7"><B>AiJsonClient</B></TD></TR><TR><TD BGCOLOR="#f3e2f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;结构化模型调用&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- llmGateway: LlmGateway</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- objectMapper: ObjectMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ call(String prompt, String payload, Class&lt;T&gt;): T</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ call(String prompt, String payload, JavaType): T</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 提取 JSON（剥代码块围栏 / 截取主体）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 解析失败追加格式强化重试一次，仍不合规报 4001</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3e2f7"><B>AiPrompts</B></TD></TR><TR><TD BGCOLOR="#f3e2f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;提示词库&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（定价 / 检测 / 解读 / 识别填充）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PRICING / FAKE_DETECT /</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CONTRACT_INTERPRET / ASSIST_FILL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 统一要求“只输出 JSON”并声明字段与取值约束</TD></TR></TABLE></TD></TR></TABLE>>];
  n8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>LlmGateway</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模型网关&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- props: AiProps</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- backends: openai-chat-completions / anthropic-messages / openai-responses</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ available(): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ chat(): ChatLanguageModel</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ streaming(): StreamingChatLanguageModel</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ describe(): String  // &lt;协议&gt;:&lt;模型&gt;，未配置为 none</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ static normalizeProtocol(String): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 超时 60s · 未配置模型时上层直接报 4001</TD></TR></TABLE></TD></TR></TABLE>>];
  n9 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7e7e7"><B>AnthropicMessagesChatModel</B></TD></TR><TR><TD BGCOLOR="#f7e7e7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;自研适配器&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseUrl / apiKey / model</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generate(...): Response&lt;AiMessage&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generate(...tools...): Response&lt;AiMessage&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generate(...handler): void  // SSE 流式</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 解析 content[]：text 拼接 / tool_use 转工具请求</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 跳过 thinking 块并关闭 thinking 降首字延迟</TD></TR></TABLE></TD></TR></TABLE>>];
  n10 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7e7e7"><B>OpenAiResponsesChatModel</B></TD></TR><TR><TD BGCOLOR="#f7e7e7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;自研适配器&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseUrl / apiKey / model</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generate(...): Response&lt;AiMessage&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generate(...tools...): Response&lt;AiMessage&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ generate(...handler): void  // SSE 流式</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 解析 output_text.delta 与 function_call</TD></TR></TABLE></TD></TR></TABLE>>];
  n11 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>HousingToolProvider</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;工具提供器（留痕）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- housingTools / toolTraceService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ provideTools(ToolProviderRequest): ToolProviderResult</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ takeKnowledgeCitations(long sessionId): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 把每个 @Tool 执行包装为“计时 → 执行 → 留痕 → 返回”</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 缓存 searchKnowledge 返回体作为来源引用（NFR-05）</TD></TR></TABLE></TD></TR></TABLE>>];
  n12 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>ToolTraceService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service（留痕）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- messageMapper: AiChatMessageMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ record(long sessionId, String toolName, String argsJson,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">         String resultJson, int latencyMs): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 写 role=3 工具消息（tool_name / args / result / latency）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- JSON 列合法性校验与超长预览兜底</TD></TR></TABLE></TD></TR></TABLE>>];
  n13 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eef4fb"><B>HousingTools</B></TD></TR><TR><TD BGCOLOR="#eef4fb"><FONT POINT-SIZE="9" COLOR="#666666">&#171;工具注册表（@Tool）&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseMapper / kbService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ searchHouses(Integer maxRent, String layoutKeyword,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">               String district, String keyword, Boolean subway): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ searchKnowledge(String question): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getHouseDetail / createAppointment / suggestPrice</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detectFakeHouse / analyzeContract</TD></TR></TABLE></TD></TR></TABLE>>];
  n14 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>AiChatSession / AiChatMessage / AiAnalysis</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">AiChatSession：user_id, scene, title, context_summary, is_transferred</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AiChatMessage：session_id, role, content, tool_name/tool_args/tool_result, citations, latency_ms</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AiAnalysis：user_id, type, target_type/target_id, input_snapshot, result, model</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 ai_chat_session / ai_chat_message / ai_analysis）</TD></TR></TABLE></TD></TR></TABLE>>];
  n15 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>KbDocument / KbChunk</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">KbDocument：title, category, source_url, content, status, chunk_count</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">KbChunk：document_id, seq(唯一), content, token_count, vector_ref</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 kb_document / kb_chunk，切片随文档级联删除）</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n1;
  n0 -> n2;
  n0 -> n3;
  n1 -> n4;
  n4 -> n5 [label="实现"];
  n5 -> n8;
  n5 -> n11 [label="Function Calling"];
  n11 -> n13 [label="委托执行"];
  n11 -> n12 [label="工具留痕"];
  n11 -> n1 [label="来源引用（citations）"];
  n3 -> n6 [label="结构化调用"];
  n6 -> n7 [label="提示词"];
  n6 -> n8 [label="同步模型"];
  n8 -> n9;
  n8 -> n10;
  n13 -> n2 [label="searchKnowledge"];
  n1 -> n14 [label="落库"];
  n3 -> n14 [label="落库"];
  n2 -> n15 [label="切片入库"];
  n12 -> n14 [label="落库"];
}
