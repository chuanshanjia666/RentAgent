digraph cls_house {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="房源管理模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>HouseController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseService: HouseService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(SaveReq): R&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ update(long, SaveReq): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ changeStatus(long, StatusReq): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ myHouses(page, size): R&lt;PageVO&lt;House&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detail(long): R&lt;Item&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ search(SearchReq): R&lt;PageVO&lt;Item&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ map(SearchReq): R&lt;List&lt;House&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ recommend(int): R&lt;List&lt;House&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>AdminController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller(管理员)&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- adminService: AdminService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pending(page, size): R&lt;PageVO&lt;House&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ audit(long, Map): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fakeDetect(long): R&lt;DetectVO&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>HouseService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseMapper: HouseMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- imageMapper: HouseImageMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- authService: AuthService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- notificationService: NotificationService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(SaveReq, long): House</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ update(long, SaveReq, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ changeStatus(long, String, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ audit(long, boolean, String, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ detail(long): Item</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toItem(House, User): Item</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ recommend(Long, int): List&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ST_PENDING/ST_PASSED/ST_REJECTED/ST_ONLINE/ST_OFFLINE/ST_RENTED</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 状态机校验 checkTransition()</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>HouseMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;House&gt;&#187;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selectPageByLandlord(...)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ incrViewCount(long): int</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>HouseImageMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;HouseImage&gt;&#187;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ deleteByHouseId(long): int</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>House</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- landlordId: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- title: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- community/city/district: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- layout: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- area/rent: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- lng/lat: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- viewCount: Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- avgScore: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status: Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- rejectReason: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- deleted: Integer</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（MyBatis-Plus 映射 house，逻辑删除）</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>HouseImage</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseId: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- url: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- sort: Integer</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- isCover: Boolean</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 house_image，随房源级联删除）</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3e2f7"><B>AnalysisService</B></TD></TR><TR><TD BGCOLOR="#f3e2f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service(AI 分析)&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- aiAnalysisMapper: AiAnalysisMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- llmGateway: LlmGateway</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ assistFill(AiFillReq, long): AiFillVO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fakeDetect(long, long): DetectVO</TD></TR></TABLE></TD></TR></TABLE>>];
  x8 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>AuthService</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  x9 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>NotificationService</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n2;
  n1 -> n2 [label="审核"];
  n1 -> n7 [label="FR-16 检测"];
  n2 -> x8 [label="实名校验"];
  n2 -> x9 [label="审核结果通知"];
  n2 -> n3;
  n2 -> n4;
  n3 -> n5 [label="映射"];
  n4 -> n6 [label="映射"];
}
