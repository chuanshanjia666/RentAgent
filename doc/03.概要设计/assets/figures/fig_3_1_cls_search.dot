digraph cls_search {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="检索与推荐模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>HouseController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseService / searchService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ search(SearchReq): R&lt;PageVO&lt;Item&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ map(SearchReq): R&lt;List&lt;House&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ recommend(int): R&lt;List&lt;House&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>FavoriteController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- searchService: SearchService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ add(long houseId): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ remove(long houseId): R&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ list(page, size): R&lt;PageVO&lt;House&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>SearchService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseMapper: HouseMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- favoriteMapper: FavoriteMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- redis: StringRedisTemplate</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ search(SearchReq): Page&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ mapHouses(SearchReq): List&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addFavorite(long, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ removeFavorite(long, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ favorites(long, long, long): Page&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 动态条件拼装 buildWrapper()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 唯一索引兜底防重复收藏</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>HouseService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service(推荐)&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- favoriteMapper: FavoriteMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ recommend(Long, int): List&lt;House&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 区域/户型偏好加权 + 热度排序</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>HouseMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;House&gt;&#187;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selectSearch(SearchReq)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selectByGeoRange(lngMin, lngMax, latMin, latMax)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ topByViewCount(int)</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>FavoriteMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;Favorite&gt;&#187;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selectHousePageByUser(long, page, size)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- UNIQUE(user_id, house_id) 防重</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>House</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 检索域字段：status / district / rent / layout</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- orientation / community / lng / lat</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- viewCount / avgScore</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（仅 status=已上架 进入检索域）</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>Favorite</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- userId: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseId: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- createdAt: LocalDateTime</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 favorite，m:n 联系表）</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n2 [label="FR-09/10"];
  n0 -> n3 [label="FR-11"];
  n1 -> n2 [label="FR-25"];
  n2 -> n4;
  n2 -> n5;
  n3 -> n5 [label="偏好样本"];
  n4 -> n6 [label="映射"];
  n5 -> n7 [label="映射"];
}
