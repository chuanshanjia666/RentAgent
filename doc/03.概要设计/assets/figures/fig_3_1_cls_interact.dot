digraph cls_interact {
  rankdir=TB; nodesep=0.42; ranksep=0.55; splines=spline;
  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15, labelloc="t",
         label="评价与消息模块类图", fontsize=13, fontcolor="#1f3a5f"];
  node  [fontname="Microsoft YaHei", fontsize=9.5, shape=plaintext, margin=0];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#4a6f9e", penwidth=1.0,
         arrowsize=0.7, style=solid];
  n0 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>ReviewController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reviewService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(ReviewReq): R&lt;Review&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ list(long houseId, page, size): R&lt;PageVO&lt;Map&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n1 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>NotificationController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- notificationService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ list(onlyUnread, page, size): R&lt;PageVO&lt;Notification&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ unreadCount(): R&lt;Long&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ read(long id): R&lt;Void&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n2 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#fdf3dc"><B>ReportController</B></TD></TR><TR><TD BGCOLOR="#fdf3dc"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Controller&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reportService</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(ReportReq): R&lt;Report&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  n3 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>ReviewService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reviewMapper: ReviewMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- orderMapper: LeaseOrderMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- houseMapper: HouseMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(long, int, int, String, long): Review</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listByHouse(long, long, long): Page&lt;Map&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 校验订单已完成 + lease_order_id 唯一（一单一评）</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 刷新 house.avg_score 冗余均分</TD></TR></TABLE></TD></TR></TABLE>>];
  n4 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>NotificationService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- notificationMapper: NotificationMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ send(Long, int, String, String, String, Long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ page(long, boolean, long, long): Page&lt;Notification&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ unreadCount(long): long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ markRead(long, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 关键事件统一触达（5 秒内可见）</TD></TR></TABLE></TD></TR></TABLE>>];
  n5 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#eaf6ea"><B>ReportService</B></TD></TR><TR><TD BGCOLOR="#eaf6ea"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Service&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reportMapper: ReportMapper</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(long, int, long, String): Report</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ handle(long, String, long): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ page(int, long, long): Page&lt;Report&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 评价类举报直接隐藏；房源类通知房东整改</TD></TR></TABLE></TD></TR></TABLE>>];
  n6 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>ReviewMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;Review&gt;&#187;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ selectByHousePage(...)</TD></TR></TABLE></TD></TR></TABLE>>];
  n7 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#efe9f7"><B>NotificationMapper</B></TD></TR><TR><TD BGCOLOR="#efe9f7"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Mapper&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#171;extends BaseMapper&lt;Notification&gt;&#187;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ countUnread(long): long</TD></TR></TABLE></TD></TR></TABLE>>];
  n8 [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f7f0e6"><B>Review / Notification / Report</B></TD></TR><TR><TD BGCOLOR="#f7f0e6"><FONT POINT-SIZE="9" COLOR="#666666">&#171;Entity&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">Review：lease_order_id(唯一), house_id, 房源分/房东分(1~5), content, status</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Notification：user_id, type, title, content, ref_type, ref_id, is_read</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Report：reporter_id, target_type, target_id, reason, status, handle_by</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（映射 review / notification / report）</TD></TR></TABLE></TD></TR></TABLE>>];
  x9 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>LeaseOrderMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  x10 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>HouseMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  x11 [shape=plaintext, fontsize=9, fontcolor="#666666", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f2f2f2"><B>ReportMapper</B></TD></TR><TR><TD BGCOLOR="#f2f2f2"><FONT POINT-SIZE="9" COLOR="#666666">&#171;模块外协作者&#187;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">（其它模块）</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">—</TD></TR></TABLE></TD></TR></TABLE>>];
  n0 -> n3;
  n1 -> n4;
  n2 -> n5;
  n3 -> n6;
  n3 -> x9 [label="完成校验收敛"];
  n3 -> x10 [label="刷新均分"];
  n4 -> n7;
  n5 -> x11;
  n6 -> n8 [label="同一实体包"];
  n7 -> n8 [label="同一实体包"];
  n5 -> n4 [label="处理结果通知"];
}
