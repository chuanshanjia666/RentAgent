digraph mod_auth {
  rankdir=TB; nodesep=0.28; ranksep=0.50; compound=true;

  graph [fontname="Microsoft YaHei", bgcolor="white", margin=0.15];
  node  [fontname="Microsoft YaHei", fontsize=11, shape=box, style="filled,rounded",
         fillcolor="#eef4fb", color="#4a7ebb", penwidth=1.1, margin="0.14,0.09"];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#5c5c5c", penwidth=1.0, arrowsize=0.7];

  node [width=2.3, height=0.52];

  subgraph cluster_0 {
    label="用户与权限模块　（FR-01 ~ FR-04）"; fontsize=13; fontcolor="#1f3a5f";
    style="rounded,filled"; fillcolor="#eef4fb"; color="#4a7ebb"; penwidth=1.4; margin=12;
    root [label="模块入口（Controller 层）", style="filled,rounded", fillcolor="#cfe0f5",
          color="#31527a", penwidth=1.6, width=3.0];
  c0 [label="AuthController", fillcolor="#fdf3dc", color="#d1a542"];
  {rank=same; c0;}

    root -> c0 [style=invis];
  root -> c0 [style=bold];
  }

  subgraph cluster_1 {
    label="Service 业务层"; fontsize=11; fontcolor="#2f6b2f";
    style="rounded,filled"; fillcolor="#f4fbf4"; color="#5c9c5c"; margin=10;
  s0 [label="AuthService", fillcolor="#eaf6ea", color="#5c9c5c"];
  {rank=same; s0;}

  }

  subgraph cluster_2 {
    label="Mapper 持久化层"; fontsize=11; fontcolor="#5c4478";
    style="rounded,filled"; fillcolor="#f8f5fc"; color="#8a6fb0"; margin=10;
  p0 [label="SysUserMapper", fillcolor="#efe9f7", color="#8a6fb0"];
  p1 [label="RealnameAuthMapper", fillcolor="#efe9f7", color="#8a6fb0"];
  {rank=same; p0; p1;}

  }

  subgraph cluster_3 {
    label="实体 / 数据载体"; fontsize=11; fontcolor="#7a5a30";
    style="rounded,filled"; fillcolor="#fdfaf6"; color="#b08a5c"; margin=10;
  e0 [label="SysUser", fillcolor="#f7f0e6", color="#b08a5c", shape=box, style=filled];
  e1 [label="RealnameAuth", fillcolor="#f7f0e6", color="#b08a5c", shape=box, style=filled];
  {rank=same; e0; e1;}

  }

  c0 -> s0 [style=invis];
  c0 -> s0;
  s0 -> p0;
  s0 -> p1;
  p0 -> e0 [style=dotted, arrowhead=none, color="#8c8c8c"];
  p0 -> e1 [style=dotted, arrowhead=none, color="#8c8c8c"];
  p1 -> e0 [style=dotted, arrowhead=none, color="#8c8c8c"];
  p1 -> e1 [style=dotted, arrowhead=none, color="#8c8c8c"];
}
